{
  "name": "zorya",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "prettier --check tests",
    "build:sbf": "bash scripts/build-sbf.sh",
    "build:sbf:devnet": "bash scripts/build-sbf.sh --no-default-features",
    "test": "anchor test --skip-build",
    "desk": "bash scripts/local-desk.sh",
    "desk:seed": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-./.keys/id.json} npx ts-node --transpile-only --compiler-options '{\"esModuleInterop\":true,\"resolveJsonModule\":true}' scripts/seed-local-desk.ts",
    "test:fuzz": "cargo test --manifest-path programs/zorya/Cargo.toml --lib --features mock-oracle fuzz -- --test-threads=4",
    "test:devnet-binary": "bash scripts/devnet-smoke.sh",
    "devnet:deploy": "bash scripts/devnet-deploy.sh",
    "devnet:smoke": "ANCHOR_PROVIDER_URL=${SOLANA_URL:-https://api.devnet.solana.com} ANCHOR_WALLET=${ANCHOR_WALLET:-./.keys/id.json} npx ts-node --transpile-only --compiler-options '{\"esModuleInterop\":true,\"resolveJsonModule\":true}' scripts/devnet-smoke-live.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2"
  },
  "devDependencies": {
    "@coral-xyz/anchor-cli": "0.31.1",
    "@pythnetwork/hermes-client": "^2.1.0",
    "@pythnetwork/pyth-solana-receiver": "^0.13.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "chai": "^4.5.0",
    "mocha": "^11.1.0",
    "prettier": "^3.5.3",
    "ts-mocha": "^10.1.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "rpc-websockets": "7.11.0"
  }
}
